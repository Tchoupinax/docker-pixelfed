FROM debian:trixie-slim

ENV PHP_VERSION=8.4 \
  COMPOSER_HOME=/var/www/.composer \
  COMPOSER_MEMORY_LIMIT=-1 \
  COMPOSER_ALLOW_SUPERUSER=1 \
  DEBIAN_FRONTEND=noninteractive \
  LANG=en_US.UTF-8

WORKDIR /var/www/

COPY --from=composer:2.10.3 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    nginx \
    libnginx-mod-rtmp \
    git \
    locales \
    optipng \
    pngquant \
    jpegoptim \
    gifsicle \
    ffmpeg \
    mariadb-client \
    procps \
    "php${PHP_VERSION}-fpm" \
    "php${PHP_VERSION}-cli" \
    "php${PHP_VERSION}-gd" \
    "php${PHP_VERSION}-imagick" \
    "php${PHP_VERSION}-redis" \
    "php${PHP_VERSION}-mysql" \
    "php${PHP_VERSION}-pgsql" \
    "php${PHP_VERSION}-sqlite3" \
    "php${PHP_VERSION}-intl" \
    "php${PHP_VERSION}-bcmath" \
    "php${PHP_VERSION}-zip" \
    "php${PHP_VERSION}-curl" \
    "php${PHP_VERSION}-mbstring" \
    "php${PHP_VERSION}-xml" \
    "php${PHP_VERSION}-opcache" \
  && sed -i '/en_US/s/^#//g' /etc/locale.gen \
  && locale-gen en_US.UTF-8 \
  && update-locale LANG=en_US.UTF-8 \
  && apt-get purge -y git \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /usr/share/doc /usr/share/man /var/lib/apt/lists/* /tmp/* /var/cache/apt/*

ARG BRANCH=dev
RUN git clone --depth 1 --branch "${BRANCH}" https://github.com/pixelfed/pixelfed.git /var/www \
  && rm -rf /var/www/.git

COPY nginx.conf start.nginx.sh /var/www/contrib/docker/
COPY php.production.ini "/etc/php/${PHP_VERSION}/fpm/php.ini"

# for detail why storage is copied this way, pls refer to https://github.com/pixelfed/pixelfed/pull/2137#discussion_r434468862
RUN --mount=type=cache,target=/var/www/.composer/cache \
  cp "/etc/php/${PHP_VERSION}/fpm/php.ini" "/etc/php/${PHP_VERSION}/cli/php.ini" \
  && cp -r storage storage.skel \
  && cp -r bootstrap bootstrap.skel \
  && cp /var/www/contrib/docker/nginx.conf /etc/nginx \
  && composer update --with-all-dependencies --no-security-blocking --no-interaction --prefer-dist --optimize-autoloader --no-ansi \
  && rm -rf html && ln -s public html \
  && mkdir -p /var/lib/nginx /run/php-fpm \
  && chown -R www-data:www-data /etc/nginx/nginx.conf /var/www /var/lib/nginx /run/php-fpm \
  && find /var/www -type d -exec chmod 755 {} \; \
  && find /var/www -type f -exec chmod 644 {} \; \
  && chmod 755 /var/www/contrib/docker/start.nginx.sh \
  && chmod 1777 /run \
  && sed -i \
    -e 's|^listen = .*|listen = /run/php-fpm/php-fpm.sock|' \
    -e '/^user = /d' \
    -e '/^group = /d' \
    "/etc/php/${PHP_VERSION}/fpm/pool.d/www.conf" \
  && php artisan storage:link

VOLUME /var/www/storage /var/www/bootstrap

USER www-data

CMD ["/var/www/contrib/docker/start.nginx.sh"]
